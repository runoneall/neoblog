{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "neoblog",
	"compatibility_date": "2026-10-24",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/index.ts",
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "public",
	},
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "neoblog-db",
		},
	],
}
